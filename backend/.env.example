# Server
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/cropdatabase?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Python ML
PYTHON_PATH=/usr/bin/python3
MODEL_PATH=../model.h5

# Reports
REPORTS_DIR=../reports

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE=10MB
