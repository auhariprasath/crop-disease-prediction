# Copy this file to .env (in the backend/ folder) and fill in the values
# marked below. .env is gitignored and never committed.

# Server
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# Database (MySQL)
# Create the database first: CREATE DATABASE cropdatabase;
DB_URL=jdbc:mysql://localhost:3306/cropdatabase?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Python ML
# Must point at a Python interpreter with tensorflow, opencv-python, and
# numpy installed (see backend/scripts/requirements.txt).
# Windows: PYTHON_PATH=C:/path/to/python.exe  (or just "python" if it's on PATH)
# Linux/Mac: PYTHON_PATH=/usr/bin/python3  (or just "python3" if it's on PATH)
PYTHON_PATH=python3
MODEL_PATH=../plant disease model final.h5

# Reports
REPORTS_DIR=../reports

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE=10MB
